FROM pytorch/pytorch:2.1.0-cuda12.1-cudnn8-runtime

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

# Python deps
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# PyG (separate install for CUDA compatibility)
RUN pip install torch-scatter torch-sparse torch-cluster torch-spline-conv \
    torch-geometric -f https://data.pyg.org/whl/torch-2.1.0+cu121.html

COPY . .

# Environment
ENV PYTHONPATH=/app
ENV HYDRA_FULL_ERROR=1

ENTRYPOINT ["python", "-m", "training.train"]
