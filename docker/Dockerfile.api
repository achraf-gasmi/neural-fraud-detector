FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# CPU-only deps for serving (lighter image)
COPY requirements.txt .
RUN pip install --no-cache-dir \
    torch==2.1.0 --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir fastapi uvicorn[standard] pydantic \
    numpy pandas scikit-learn shap loguru python-dotenv httpx prometheus-client omegaconf

COPY . .

ENV PYTHONPATH=/app
ENV MODEL_PATH=checkpoints/best_model.pt
ENV ARTIFACTS_DIR=data/processed/artifacts
ENV THRESHOLD=0.5

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
